!insertmacro MUI_LANGUAGE "English"
LangString CAPTION ${LANG_ENGLISH} "Paxon Setup"
LangString BRANDINGTEXT ${LANG_ENGLISH} "© 1996-2026 Ulf Haueisen"
LicenseLangString LICENSE ${LANG_ENGLISH} "License-en.txt"
LangString CLOSEPAXON ${LANG_ENGLISH} "Setup has detected that Paxon is currently running.$\r$\nPlease close Paxon now, then click OK to continue, or Cancel to exit Setup."
LangString MUSTBEADMIN ${LANG_ENGLISH} "You must be logged in as an administrator or as a member of the Power Users group when installing this program."
LangString IOTITLE1 ${LANG_ENGLISH} ": Options"
LangString IOTITLE2 ${LANG_ENGLISH} "Select Additional Tasks"
LangString IOTITLE3 ${LANG_ENGLISH} "Which additional tasks should be performed?"
LangString FIELD1 ${LANG_ENGLISH} "Select the additional tasks you would like Setup to perform while installing Paxon, then click 'Install'."
LangString FIELD2 ${LANG_ENGLISH} "Create Icon on Desktop"
LangString FIELD3 ${LANG_ENGLISH} "Create icon on Quick Launch toolbar"
LangString FIELD4 ${LANG_ENGLISH} "Register Filetypes"
LangString un.CLOSEPAXON ${LANG_ENGLISH} "Setup has detected that Paxon is currently running.$\r$\nPlease close Paxon now, then click 'OK' to continue, or 'Cancel' to exit Setup."
LangString un.MUSTBEADMIN ${LANG_ENGLISH} "You must be logged in as an administrator or as a member of the Power Users group when uninstalling this program."
LangString un.IOTITLE1 ${LANG_ENGLISH} ": Options"
LangString un.IOTITLE2 ${LANG_ENGLISH} "Uninstallation Mode"
LangString un.IOTITLE3 ${LANG_ENGLISH} "Please choose the mode of Uninstallation"
LangString un.FIELD1 ${LANG_ENGLISH} "Please choose the mode of uninstallation and click 'Uninstall' to continue."
LangString un.FIELD2 ${LANG_ENGLISH} "Keep settings"
LangString un.FIELD3 ${LANG_ENGLISH} "Uninstall completely"
LangString un.FIELD4 ${LANG_ENGLISH} "Paxon will be removed from this computer, but settings and station database remain. If you'll reinstall Paxon later, your settings will be reused."
LangString un.FIELD5 ${LANG_ENGLISH} "Paxon will be removed completely. All settings and the stations database will be deleted."
